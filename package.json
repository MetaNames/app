{
	"name": "meta-names-app",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"generate:themes": "npm run smui-theme-dark",
		"smui-theme-light": "smui-theme compile src/styles/theme/smui.css -i src/theme",
		"smui-theme-dark": "smui-theme compile src/styles/theme/smui-dark.css -i src/theme/dark",
		"dev": "vite dev",
		"build": "npm run generate:themes && vite build",
		"build:themes": "npm run generate:themes",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:integration",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run typecheck",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --plugin prettier-plugin-svelte --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@iconify/svelte": "^4.0.2",
		"@material/typography": "^14.0.0",
		"@playwright/test": "1.48.1",
		"@smui/banner": "^7.0.0",
		"@smui/button": "^7.0.0",
		"@smui/card": "^7.0.0",
		"@smui/circular-progress": "^7.0.0",
		"@smui/data-table": "^7.0.0",
		"@smui/dialog": "^7.0.0",
		"@smui/icon-button": "^7.0.0",
		"@smui/linear-progress": "^7.0.0",
		"@smui/list": "^7.0.0",
		"@smui/menu": "^7.0.0",
		"@smui/menu-surface": "^7.0.0",
		"@smui/paper": "^7.0.0",
		"@smui/select": "^7.0.0",
		"@smui/snackbar": "^7.0.0",
		"@smui/tab": "^7.0.0",
		"@smui/tab-bar": "^7.0.0",
		"@smui/textfield": "^7.0.0",
		"@smui/top-app-bar": "^7.0.0",
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/adapter-vercel": "^5.4.5",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@typescript-eslint/eslint-plugin": "^8.10.0",
		"@typescript-eslint/parser": "^8.10.0",
		"@vitest/coverage-v8": "^2.1.9",
		"eslint": "^9.13.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"globals": "^14.0.0",
		"playwright": "^1.58.2",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"smui-theme": "^7.0.0",
		"svelte": "^4.2.19",
		"svelte-check": "^4.0.5",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.0",
		"typescript": "^5.6.3",
		"vite": "^5.4.9",
		"vite-plugin-node-polyfills": "^0.22.0",
		"vite-tsconfig-paths": "^4.3.2",
		"vitest": "^2.1.9",
		"yargs": "^16.2.2"
	},
	"type": "module",
	"dependencies": {
		"@ledgerhq/hw-transport-webusb": "^6.27.2",
		"@material/theme": "^14.0.0",
		"@metanames/sdk": "^6.3.1",
		"@sentry/sveltekit": "^8.34.0",
		"@vercel/analytics": "^1.3.1",
		"@vercel/speed-insights": "^1.0.12",
		"date-fns": "^4.1.0",
		"jdenticon": "^3.3.0",
		"partisia-blockchain-applications-sdk": "^0.1.4"
	}
}
